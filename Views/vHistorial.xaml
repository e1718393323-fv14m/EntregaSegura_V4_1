<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:EntregaSegura.Models"
             x:Class="EntregaSegura.Views.vHistorial"
             Title="Historial"
             Style="{StaticResource Pagina}">
    <Grid RowDefinitions="Auto,*" Padding="20,16,20,0" RowSpacing="12">
        <VerticalStackLayout Spacing="2">
            <Label Text="Historial" Style="{StaticResource Titulo}" />
            <Label Text="Órdenes entregadas o con novedad" Style="{StaticResource Suave}" />
        </VerticalStackLayout>

        <RefreshView x:Name="refrescar" Grid.Row="1" Refreshing="refrescar_Refreshing" RefreshColor="{StaticResource Acento}">
            <CollectionView x:Name="lstOrdenes" SelectionMode="Single" SelectionChanged="lstOrdenes_SelectionChanged">
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="30" Spacing="8" HorizontalOptions="Center">
                        <Label Text="Sin registros todavía" Style="{StaticResource Seccion}" HorizontalTextAlignment="Center" />
                        <Label Text="Aquí aparecerán las entregas y novedades que registre." Style="{StaticResource Suave}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Orden">
                        <Border Style="{StaticResource Tarjeta}" Margin="0,0,0,12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="42" HeightRequest="42" StrokeThickness="0" StrokeShape="RoundRectangle 21"
                                        BackgroundColor="{StaticResource Primario}" VerticalOptions="Start">
                                    <Label Text="{Binding SecuenciaTexto}" TextColor="White" FontAttributes="Bold"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding cliente.nombre}" Style="{StaticResource Seccion}" />
                                        <Border Grid.Column="1" Style="{StaticResource Chip}" BackgroundColor="{Binding FondoEstado}">
                                            <Label Text="{Binding EstadoTexto}" TextColor="{Binding ColorEstado}" FontSize="12" FontAttributes="Bold" />
                                        </Border>
                                    </Grid>
                                    <Label Text="{Binding numero}" Style="{StaticResource Etiqueta}" />
                                    <Label Text="{Binding cliente.direccion}" Style="{StaticResource Cuerpo}" FontSize="14" />
                                    <Label Text="{Binding Resumen}" Style="{StaticResource Suave}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
