<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EntregaSegura.Views.vPerfil"
             Title="Mi perfil"
             Style="{StaticResource Pagina}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="640">

            <Border Style="{StaticResource Encabezado}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 32"
                            BackgroundColor="{StaticResource Acento}" VerticalOptions="Center">
                        <Label x:Name="lblIniciales" Text="--" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource Primario}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label x:Name="lblNombre" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label x:Name="lblCorreo" Style="{StaticResource TextoBlanco}" TextColor="#C9D3E6" />
                        <Label x:Name="lblRol" Style="{StaticResource TextoBlanco}" TextColor="{StaticResource Acento}" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mis datos" Style="{StaticResource Seccion}" />
                    <Label x:Name="lblCedula" Style="{StaticResource Cuerpo}" />
                    <Label x:Name="lblTelefono" Style="{StaticResource Cuerpo}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Vehículo asignado" Style="{StaticResource Seccion}" />
                    <Label x:Name="lblPlaca" Style="{StaticResource Cuerpo}" />
                    <Label x:Name="lblModelo" Style="{StaticResource Cuerpo}" />
                    <Label x:Name="lblCapacidad" Style="{StaticResource Cuerpo}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Tarjeta}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mi jornada" Style="{StaticResource Seccion}" />
                    <Label x:Name="lblEntregadas" Style="{StaticResource Cuerpo}" />
                    <Label x:Name="lblNovedades" Style="{StaticResource Cuerpo}" />
                    <Label x:Name="lblMonto" Style="{StaticResource Cuerpo}" FontAttributes="Bold" TextColor="{StaticResource Exito}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="indicador" IsRunning="False"
                               Color="{StaticResource Acento}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
