<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EntregaSegura.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ================= PALETA ================= -->
            <Color x:Key="Primario">#0B1F3A</Color>
            <Color x:Key="PrimarioClaro">#1C3A66</Color>
            <Color x:Key="Acento">#F7931E</Color>
            <Color x:Key="Fondo">#F4F6FA</Color>
            <Color x:Key="Blanco">#FFFFFF</Color>
            <Color x:Key="Texto">#14213D</Color>
            <Color x:Key="TextoSuave">#5A6478</Color>
            <Color x:Key="Linea">#DDE2EC</Color>
            <Color x:Key="Exito">#1E7B34</Color>
            <Color x:Key="ExitoSuave">#E3F4E7</Color>
            <Color x:Key="Peligro">#B3261E</Color>
            <Color x:Key="PeligroSuave">#FCE8E6</Color>
            <Color x:Key="Aviso">#8A4B00</Color>
            <Color x:Key="AvisoSuave">#FFF1DF</Color>
            <Color x:Key="InfoSuave">#E8EEF8</Color>

            <!-- ================= PÁGINA ================= -->
            <Style x:Key="Pagina" TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Fondo}" />
            </Style>

            <!-- ================= TEXTOS ================= -->
            <Style x:Key="Titulo" TargetType="Label">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>
            <Style x:Key="Seccion" TargetType="Label">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>
            <Style x:Key="Etiqueta" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
            </Style>
            <Style x:Key="Cuerpo" TargetType="Label">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>
            <Style x:Key="Suave" TargetType="Label">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextColor" Value="{StaticResource TextoSuave}" />
            </Style>
            <Style x:Key="Numero" TargetType="Label">
                <Setter Property="FontSize" Value="30" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
            </Style>
            <Style x:Key="TextoBlanco" TargetType="Label">
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- ================= CONTENEDORES ================= -->
            <Style x:Key="Tarjeta" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
                <Setter Property="Stroke" Value="{StaticResource Linea}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="Encabezado" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Primario}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20" />
                <Setter Property="Padding" Value="20" />
            </Style>
            <Style x:Key="Caja" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
                <Setter Property="Stroke" Value="{StaticResource Linea}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="MinimumHeightRequest" Value="50" />
            </Style>
            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="HorizontalOptions" Value="Start" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>
            <Style x:Key="Banner" TargetType="Border">
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 12" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="BackgroundColor" Value="{StaticResource InfoSuave}" />
            </Style>

            <!-- ================= CONTROLES ================= -->
            <Style x:Key="Entrada" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Texto}" />
                <Setter Property="PlaceholderColor" Value="#9AA3B5" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="MinimumHeightRequest" Value="48" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="BotonPrimario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Acento}" />
                <Setter Property="TextColor" Value="{StaticResource Primario}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="MinimumHeightRequest" Value="54" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal" />
                            <VisualState x:Name="Disabled">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="#D3D8E2" />
                                    <Setter Property="TextColor" Value="#7A8396" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
            <Style x:Key="BotonExito" TargetType="Button" BasedOn="{StaticResource BotonPrimario}">
                <Setter Property="BackgroundColor" Value="{StaticResource Exito}" />
                <Setter Property="TextColor" Value="White" />
            </Style>
            <Style x:Key="BotonSecundario" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Blanco}" />
                <Setter Property="TextColor" Value="{StaticResource Primario}" />
                <Setter Property="BorderColor" Value="{StaticResource Primario}" />
                <Setter Property="BorderWidth" Value="1.5" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="MinimumHeightRequest" Value="50" />
            </Style>
            <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource BotonSecundario}">
                <Setter Property="TextColor" Value="{StaticResource Peligro}" />
                <Setter Property="BorderColor" Value="{StaticResource Peligro}" />
            </Style>
            <Style x:Key="BotonTexto" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource PrimarioClaro}" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="8,0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
